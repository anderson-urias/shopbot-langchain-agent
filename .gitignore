.installed.cfg
*.egg

# --- JUPYTER NOTEBOOK / IPYTHON ---
.ipynb_checkpoints/
*-checkpoint.ipynb
.virtual_documents/

# --- CACHES DE TESTE, LINTER E COVERAGE ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

